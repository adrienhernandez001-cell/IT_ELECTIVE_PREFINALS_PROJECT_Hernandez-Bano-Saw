@model IEnumerable<IT_ELECTIVE_PREFINALS_PROJECT.Models.Ticket>

@{
    ViewData["Title"] = "Tickets";
}

<div class="container mt-4">
    <h1>Tickets</h1>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Subject</th>
                <th>Customer</th>
                <th>Category</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Created</th>
                <th>Due Date</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var ticket in Model)
            {
                <tr>
                    <td>@ticket.Subject</td>
                    <td>@ticket.Customer.CompanyName</td>
                    <td>@ticket.Category.Name</td>
                    <td>@ticket.Priority.Name</td>
                    <td>@ticket.Status.Name</td>
                    <td>@ticket.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        @(ticket.DueDate?.ToString("yyyy-MM-dd") ?? "Not set")
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>