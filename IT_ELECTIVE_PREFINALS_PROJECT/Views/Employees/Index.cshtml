@model IEnumerable<IT_ELECTIVE_PREFINALS_PROJECT.Models.Employee>

<h2>Employees</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Job Title</th>
            <th>Department</th>
            <th>Active</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.FirstName @item.LastName</td>
                <td>@item.Email</td>
                <td>@item.JobTitle</td>
                <td>@item.Department.Name</td>
                <td>@item.IsActive</td>
            </tr>
        }
    </tbody>
</table>